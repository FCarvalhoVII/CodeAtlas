[embedding]
provider = "fake"
model = "deterministic"
# Fake embeddings accept 1-32 dimensions. OpenAI dimensions are model-dependent.
dimensions = 8
timeout_seconds = 30

[llm]
provider = "fake"
model = "deterministic"

[index]
top_k = 8
storage_path = ".codeatlas"
batch_size = 32
max_chunk_lines = 100
min_score = 0.0
candidate_multiplier = 4

[logging]
level = "INFO"
json = true

