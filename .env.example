# Copy this file to .env only if your shell or tooling loads it explicitly.
# CodeAtlas never reads .env files automatically.
CODEATLAS_EMBEDDING__PROVIDER=fake
CODEATLAS_EMBEDDING__MODEL=deterministic
CODEATLAS_INDEX__BATCH_SIZE=32
CODEATLAS_INDEX__MAX_CHUNK_LINES=100
CODEATLAS_INDEX__TOP_K=8
CODEATLAS_INDEX__MIN_SCORE=0
CODEATLAS_INDEX__CANDIDATE_MULTIPLIER=4
# Remote embeddings require an explicit provider/model selection:
# CODEATLAS_EMBEDDING__PROVIDER=openai
# CODEATLAS_EMBEDDING__MODEL=text-embedding-3-small
CODEATLAS_LLM__PROVIDER=fake
CODEATLAS_LLM__MODEL=deterministic
# Remote answers require an explicit provider/model selection:
# CODEATLAS_LLM__PROVIDER=openai
# CODEATLAS_LLM__MODEL=your-structured-output-capable-model
# CODEATLAS_LLM__TIMEOUT_SECONDS=60
# CODEATLAS_ANSWER__MAX_CONTEXT_CHARS=24000
# CODEATLAS_OPENAI_API_KEY=

